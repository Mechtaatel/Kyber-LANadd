+// Kyber's Linux CLI hosts the x86_64 Windows game. New Proton releases include
+// an architecture suffix; never select the aarch64 asset or a checksum file.
+pub(crate) fn is_supported_asset(name: &str) -> bool {
+    let Some(version) = name
+        .strip_prefix("GE-Proton")
+        .and_then(|name| name.strip_suffix(".tar.gz"))
+    else {
+        return false;
+    };
+    let version = version.strip_suffix("-x86_64").unwrap_or(version);
+    let Some((major, minor)) = version.split_once('-') else {
+        return false;
+    };
+    [major, minor]
+        .iter()
+        .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::is_supported_asset;
+
+    #[test]
+    fn accepts_current_x86_64_and_legacy_names() {
+        assert!(is_supported_asset("GE-Proton11-7-x86_64.tar.gz"));
+        assert!(is_supported_asset("GE-Proton10-1.tar.gz"));
+    }
+
+    #[test]
+    fn rejects_other_architectures_checksums_and_malformed_names() {
+        for name in [
+            "GE-Proton11-7-aarch64.tar.gz",
+            "GE-Proton11-7-x86_64.sha512sum",
+            "GE-Proton11-7.tar.gz.sha512sum",
+            "GE-Proton11-7-x86_64.tar.gz.exe",
+            "prefix-GE-Proton11-7.tar.gz",
+            "GE-Proton11-7-LoL.tar.gz",
+            "GE-Proton-7.tar.gz",
+            "GE-Proton11-.tar.gz",
+            "GE-Proton11-seven.tar.gz",
+            "GE-Proton11-7.tar.zst",
+        ] {
+            assert!(!is_supported_asset(name), "unexpected supported asset: {}", name);
+        }
+    }
+}
